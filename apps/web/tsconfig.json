{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": ".",
    "jsx": "preserve",
    "module": "ESNext",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "@emplois-burkina/domain": ["../../packages/domain/src/index.ts"],
      "@emplois-burkina/domain/*": ["../../packages/domain/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": [
      "node"
    ],
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
