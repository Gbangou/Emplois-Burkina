# ── Legacy app ────────────────────────────────────────────
PORT=8088
NODE_ENV=production

# ── Next.js web (apps/web) ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── AdSense après approbation Google ──────────────────────
# Exemple attendu: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_MARKET_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_MARKET_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FORMATION_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_FORMATION_SIDEBAR=

# ── Affiliation utile formations/outils ───────────────────
# URLs partenaires reelles. Si vide, l'app redirige vers une page interne utile.
# Candidatures recommandees:
# Coursera: https://www.coursera.org/about/affiliates
# Udemy: https://www.udemy.com/affiliate/
# edX: https://www.edx.org/affiliate-program
# Skillshare: https://www.skillshare.com/en/affiliates
# Grammarly: https://www.grammarly.com/affiliates
# Fiverr: https://www.fiverr.com/partnerships/affiliates
EMPLOIS_BURKINA_AFFILIATE_CV_ATS_URL=
EMPLOIS_BURKINA_AFFILIATE_ENGLISH_URL=
EMPLOIS_BURKINA_AFFILIATE_REMOTE_URL=
EMPLOIS_BURKINA_AFFILIATE_OFFICE_URL=

# ── Clerk authentication ──────────────────────────────────
# Créez un compte sur https://clerk.com et copiez vos clés
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/recruteur
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/recruteur

# ── NestJS API (apps/api) ─────────────────────────────────
# PostgreSQL via Supabase ou Neon (gratuit)
# Supabase: https://supabase.com → Project → Settings → Database
# Neon:     https://neon.tech
DATABASE_URL=postgresql://user:password@host:5432/emplois-burkina
EMPLOIS_BURKINA_ADMIN_TOKEN=change-me-with-a-long-random-secret
EMPLOIS_BURKINA_EVENT_SALT=change-me-too-for-anonymous-analytics
EMPLOIS_BURKINA_BASE_URL=https://emplois-burkina.com
EMPLOIS_BURKINA_CRAWLER_AGENT=Emplois BurkinaBot/0.1 (+contact: contact@emplois-burkina.com)
EMPLOIS_BURKINA_DETAIL_LIMIT=18
EMPLOIS_BURKINA_REQUEST_DELAY_MS=350
EMPLOIS_BURKINA_AUTOMATION_INTERVAL_MINUTES=60
EMPLOIS_BURKINA_AUTOMATION_RUN_ON_START=true
EMPLOIS_BURKINA_AUTOMATION_MAX_AGE_HOURS=3
EMPLOIS_BURKINA_QUALITY_STRICT=true
EMPLOIS_BURKINA_REVENUE_TARGET_FCFA=1000000

# ── Paiements services optionnels ─────────────────────────
# manual_mobile_money = encaissement direct avec preuve envoyee par l'utilisateur.
# pawapay_payment_page = page de paiement pawaPay + callbacks serveur.
EMPLOIS_BURKINA_PAYMENT_MODE=manual_mobile_money
EMPLOIS_BURKINA_PAYMENT_PROVIDER=Orange Money / Moov Money
EMPLOIS_BURKINA_PAYMENT_ACCOUNT_NAME=Emplois Burkina
EMPLOIS_BURKINA_PAYMENT_NUMBER=
PAWAPAY_API_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
PAWAPAY_COUNTRY=BFA
PAWAPAY_CALLBACK_SECRET=

FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
SOCIAL_WEBHOOK_URL=
SOCIAL_PUBLISH_LIVE=false
SOCIAL_PUBLISH_LIMIT=3
SOCIAL_QUEUE_LIMIT=20
SOCIAL_AUTOPUBLISH=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
