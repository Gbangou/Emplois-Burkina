# ── Legacy app ────────────────────────────────────────────
PORT=8088
NODE_ENV=production

# ── Next.js web (apps/web) ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── Clerk authentication ──────────────────────────────────
# Créez un compte sur https://clerk.com et copiez vos clés
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/recruteur
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/recruteur

# ── NestJS API (apps/api) ─────────────────────────────────
# PostgreSQL via Supabase ou Neon (gratuit)
# Supabase: https://supabase.com → Project → Settings → Database
# Neon:     https://neon.tech
DATABASE_URL=postgresql://user:password@host:5432/emplois-burkina
EMPLOIS_BURKINA_ADMIN_TOKEN=change-me-with-a-long-random-secret
EMPLOIS_BURKINA_EVENT_SALT=change-me-too-for-anonymous-analytics
EMPLOIS_BURKINA_BASE_URL=https://emplois-burkina.com
EMPLOIS_BURKINA_CRAWLER_AGENT=Emplois BurkinaBot/0.1 (+contact: contact@emplois-burkina.com)
EMPLOIS_BURKINA_DETAIL_LIMIT=18
EMPLOIS_BURKINA_REQUEST_DELAY_MS=350
EMPLOIS_BURKINA_AUTOMATION_INTERVAL_MINUTES=360
EMPLOIS_BURKINA_AUTOMATION_RUN_ON_START=true
EMPLOIS_BURKINA_AUTOMATION_MAX_AGE_HOURS=30
EMPLOIS_BURKINA_QUALITY_STRICT=true
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
SOCIAL_WEBHOOK_URL=
SOCIAL_PUBLISH_LIVE=false
SOCIAL_PUBLISH_LIMIT=3
SOCIAL_QUEUE_LIMIT=20
SOCIAL_AUTOPUBLISH=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
